nextflow_process {

    name "Test Process SCATAC_PSEUDOBULK"
    script "../../../modules/local/scatac_pseudobulk/main.nf"
    process "SCATAC_PSEUDOBULK"

    tag "modules"
    tag "modules_local"
    tag "scatac"

    test("Should aggregate per-cell counts to pseudo-bulk - stub") {

        options "-stub-run"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_sample' ],
                    file('cell_counts.tsv')
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.counts
            assert process.out.stats
            assert process.out.versions
            assert snapshot(process.out).match()
        }
    }
    test("SCATAC_PSEUDOBULK - aggregates coverage without fabricating alleles") {
        tag "correctness_regression"

        when {
            params {
                min_cells_per_snp = 1
            }
            process {
                """
                def counts_content = '''barcode\\tchrom\\tpos\\tref\\talt\\toverlap_count
AAACGAAC-1\\tchr1\\t100\\tA\\tG\\t5
AAACGAAT-1\\tchr1\\t100\\tA\\tG\\t8
AAACGAAC-1\\tchr1\\t200\\tC\\tT\\t3
'''
                def counts_file = file("${workDir}/test_allele_counts.tsv")
                counts_file.text = counts_content

                input[0] = [
                    [id: 'test_sample'],
                    counts_file
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.counts.size() == 1 },
                { assert process.out.stats.size() == 1 },
                { assert file(process.out.counts[0][1]).readLines()[0] == "chrom\tpos\tref\talt\toverlap_count\tn_cells" },
                { assert file(process.out.counts[0][1]).readLines().drop(1).toSet() == ["chr1\t100\tA\tG\t13\t2", "chr1\t200\tC\tT\t3\t1"].toSet() },
                { assert !file(process.out.counts[0][1]).text.contains("ref_count") }
            )
        }
    }

}
