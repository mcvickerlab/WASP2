nextflow_process {

    name "Test Process WASP2_FIND_IMBALANCE"
    script "../../../modules/local/wasp2_find_imbalance/main.nf"
    process "WASP2_FIND_IMBALANCE"

    tag "modules"
    tag "modules_local"
    tag "wasp2"

    test("Should compute allelic imbalance statistics - real") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_real' ],
                    file("${projectDir}/tests/data/real_counts.tsv")
                ]
                input[1] = 1    // min_count (low threshold for test data)
                input[2] = 1    // pseudocount
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.results.size() == 1 },
                { assert path(process.out.results[0][1]).text.contains("pval") },
                { assert path(process.out.results[0][1]).readLines().size() >= 2 },
                { assert process.out.versions.size() == 1 }
            )
        }
    }

    test("Should compute allelic imbalance statistics - stub") {

        options "-stub-run"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_sample' ],
                    file("${projectDir}/tests/data/stub_counts.tsv")
                ]
                input[1] = 10   // min_count
                input[2] = 1    // pseudocount
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
            assert process.out.versions
        }
    }
    test("Preserves peak membership and zero pseudocount in actual analysis") {
        tag "correctness_regression"
        when {
            process {
                """
                def counts_file = file("${workDir}/peak_counts.tsv")
                counts_file.text = '''chrom\tpos\tref\talt\tGT\tregion\tref_count\talt_count\tother_count\nchr1\t100\tA\tG\t0|1\tpeak_shared\t5\t3\t0\nchr1\t120\tC\tT\t0|1\tpeak_shared\t4\t6\t0\n'''
                input[0] = [[id:'peak_test'], counts_file]
                input[1] = 0
                input[2] = 0
                """
            }
        }
        then {
            assert process.success
            def rows = path(process.out.results[0][1]).readLines()
            assert rows.size() == 2
            def result = [rows[0].split('\t'), rows[1].split('\t')].transpose().collectEntries()
            assert result.region == 'peak_shared'
            assert result.snp_count == '2'
            assert result.N == '18'
        }
    }

}
